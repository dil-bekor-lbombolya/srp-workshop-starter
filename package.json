{
  "name": "srp-workshop-typescript",
  "version": "1.0.0",
  "description": "Single Responsibility Principle (SRP) Workshop in TypeScript",
  "main": "dist/StudentGradeManager.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:starter": "npm run build && node dist/StudentGradeManager.js",
    "dev": "npm run build && npm run start:starter",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "solid",
    "srp",
    "single-responsibility-principle",
    "typescript",
    "refactoring",
    "workshop"
  ],
  "author": "SRP Workshop",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
